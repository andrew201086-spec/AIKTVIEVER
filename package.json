{
  "name": "cbct-viewer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Просмотр конусно-лучевой томографии челюстей: срезы, объём, панорама, срезы по зубам и заключение",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc && CBCT_TARGET=desktop vite build",
    "app": "npm run build:app && electron .",
    "build:mac": "npm run build:app && electron-builder --mac --arm64",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && tsc --noEmit && npm run test",
    "preview": "vite preview",
    "deploy": "npm run build && cd dist && git init && git checkout -B gh-pages && git add . && git commit -m 'Deploy to GitHub Pages' && git remote add origin https://github.com/andrew201086-spec/AIKTVIEVER.git && git push -f origin gh-pages && rm -rf .git"
  },
  "dependencies": {
    "@cornerstonejs/core": "1.77.2",
    "@cornerstonejs/dicom-image-loader": "1.77.2",
    "@cornerstonejs/streaming-image-volume-loader": "1.77.2",
    "@cornerstonejs/tools": "1.77.2",
    "@kitware/vtk.js": "30.4.1",
    "dicom-parser": "^1.8.21",
    "jszip": "^3.10.1",
    "lucide-react": "^0.412.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "ru.cbct.viewer",
    "productName": "Просмотр КЛКТ",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "Просмотр КЛКТ",
      "artifactName": "CBCT-Viewer-${version}-${arch}.${ext}"
    }
  }
}
